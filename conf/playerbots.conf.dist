####################################################################################################

####################################################################################################
# 角色扮演策略
#

# 随机机器人的行为将更像真实玩家（实验性）
# 此选项将覆盖 AiPlayerbot.AutoDoQuests、RandomBotTeleLowerLevel 和 RandomBotTeleHigherLevel
# 默认：1 （启用）
AiPlayerbot.EnableNewRpgStrategy = 1

# 控制机器人 RPG 状态的概率权重。仅当状态满足其前提时才生效。​
# 权重总和不必为 100。设置为 0 以禁用该状态。
#
# WanderRandom  (默认：15  Move randomly nearby to find and kill mobs)
# WanderNpc     (默认：20  Randomly interact with nearby NPCs​)
# GoGrind       (默认：15  Go to nearby level-appropriate locations to grind for killing mobs)
# GoCamp        (默认：10  Return to a nearby camp depending on innkeeper/flightmaster)​
# DoQuest       (默认：60  Select quest from the quest log and head to the location to attempt completion​)
# TravelFlight  (默认：15  Go to the nearest flightmaster and fly to a level-appropriate area)
# Rest          (默认：5   Take a break for a while and do nothing)
# OutdoorPvp    (默认：10  Participate in outdoor PvP capture points if already in an outdoor PvP zone)
AiPlayerbot.RpgStatusProbWeight.WanderRandom = 15
AiPlayerbot.RpgStatusProbWeight.WanderNpc = 20
AiPlayerbot.RpgStatusProbWeight.GoGrind = 15
AiPlayerbot.RpgStatusProbWeight.GoCamp = 10
AiPlayerbot.RpgStatusProbWeight.DoQuest = 60
AiPlayerbot.RpgStatusProbWeight.TravelFlight = 15
AiPlayerbot.RpgStatusProbWeight.Rest = 5
AiPlayerbot.RpgStatusProbWeight.OutdoorPvp = 10

