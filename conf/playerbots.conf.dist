##################################################
# PLAYERBOTS 配置文件                              #
##################################################

# 概述
# "Randombot（随机机器人）"：与玩家分开登录、填充世界的随机生成机器人。可自动刷怪、做任务、升级、更新装备，可被邀请入队并接受指令。
# "AddClass 机器人"：来自 AddClassAccountPoolSize 账户的机器人，用于快速向队伍添加任意职业、已升级且已配装的机器人，适合快速组队。
# "Altbot（小号机器人）"：玩家账号上的角色，可由玩家登录并像随机机器人一样被邀请入队、接受指令，适合长期进度游玩。
# 控制机器人及设置策略的命令说明见 Wiki：https://github.com/mod-playerbots/mod-playerbots/wiki/Playerbot-Commands

####################################################################################################
# 章节索引
#   常规设置
#    玩家机器人设置
#        常规
#        召唤选项
#        坐骑
#        装备
#        拾取
#        计时器
#        距离
#        阈值
#        任务
#        战斗
#        作弊/便利
#        法术
#        飞行路线
#        专业
#    随机机器人专用设置
#        常规
#        等级
#        装备
#        任务
#        活动
#        法术
#        策略
#        RPG 策略
#        传送
#        战场、竞技场与 PvP
#        随机机器人时序与行为
#    预设天赋
#        说明
#        战士
#        圣骑士
#        猎人
#        盗贼
#        牧师
#        死亡骑士
#        萨满
#        法师
#        术士
#        德鲁伊
#    随机机器人默认天赋
#        战士
#        圣骑士
#        猎人
#        盗贼
#        牧师
#        死亡骑士
#        萨满
#        法师
#        术士
#        德鲁伊
#    团队副本
#    玩家机器人系统设置
#        数据库与连接
#        调试
#        聊天设置
#        日志
#    已弃用（临时）
####################################################################################################

###################################
#                                 #
# 常规设置                          #
#                                 #
###################################

####################################################################################################

# 启用或禁用 Playerbots 模块
AiPlayerbot.Enabled = 1

# 启用随机机器人系统
AiPlayerbot.RandomBotAutologin = 1

# 随机机器人数量（在线池目标会定期在最小值与最大值之间重新随机）
# 当 min < max 时，机器人会随机上下线以贴近目标，而不是最终一直涨到最大值。
AiPlayerbot.MinRandomBots = 500
AiPlayerbot.MaxRandomBots = 500

# 随机机器人账户
# 设为 0 则根据 MaxRandomBots、EnablePeriodicOnlineOffline
# 及其比例和 AddClassAccountPoolSize 自动计算所需账户数；若需创建多于所需数量的账户可手动设置。
# 若手动值小于所需值，系统将覆盖为所需值。
# 默认：0（自动）
AiPlayerbot.RandomBotAccountCount = 0

# AddClass 账户
# 为 addclass 命令预留的机器人账户数量。与随机机器人相同，每个账户有
# 10 个机器人（若禁用 WotLK 则为 9 个），每个职业一个。
AiPlayerbot.AddClassAccountPoolSize = 50

# 创建的机器人账户（任意类型）名称前缀。
# 存在机器人账户时不要更改此前缀。
AiPlayerbot.RandomBotAccountPrefix = "rndbot"

# 删除所有随机机器人账户
# 应用时设为 1 并运行 worldserver。删除完成后，若需
# 重新创建随机机器人，改回 0 并再次运行 worldserver。
AiPlayerbot.DeleteRandomBotAccounts = 0

# 无真实玩家在线时禁用随机机器人
# 默认：0 （服务器启动时随机机器人即登录）
# 启用后，随机机器人仅在真实玩家登录 30 秒（默认）后才登录，并会在
# 所有真实玩家登出 300 秒（默认）后登出
AiPlayerbot.DisabledWithoutRealPlayer = 0
AiPlayerbot.DisabledWithoutRealPlayerLoginDelay = 30
AiPlayerbot.DisabledWithoutRealPlayerLogoutDelay = 300

# 队伍中最后一名真实玩家离开后，机器人在此延迟（秒）后离队，避免误断线导致解散。
# 不适用于服务器重启/机器人登录恢复（这些情况在下一 world tick 离队）。
# 默认：180
AiPlayerbot.BotLeaveGroupDelayWhenNoRealPlayer = 180

####################################################################################################

###################################
#                                 #
# 玩家机器人设置                    #
#                                 #
###################################

####################################################################################################

####################################################################################################
# 一般的
#

# 玩家可以同时控制的机器人的最大数量
AiPlayerbot.MaxAddedBots = 40

# 启用/禁用通过 addclass 命令创建机器人（0 = 仅 GM，1 = 启用）
# 默认：1 （启用）
AiPlayerbot.AddClassCommand = 1

# 机器人队伍邀请权限级别（0 = 仅 GM，1 = 根据级别接受，2 = 始终接受）
# 默认：1 （按等级接受）
AiPlayerbot.GroupInvitationPermission = 1

# 即使主人离开，也要让替代机器人留在队伍中
# 0 = 禁用（默认行为）
# 1 = 启用（防止机器人自动离开队伍）
AiPlayerbot.KeepAltsInGroup = 0

# 在玩家登录时将所有玩家 alt 自动登录为 altbot
AiPlayerbot.BotAutologin = 0

# 允许/拒绝从玩家账户邀请替代机器人
AiPlayerbot.AllowAccountBots = 1

# 允许/拒绝邀请 altbot 加入玩家公会
AiPlayerbot.AllowGuildBots = 1

# 允许链接账户以共享 altbot 控制
AiPlayerbot.AllowTrustedAccountBots = 1

# 随机机器人将与附近的随机机器人创建公会
# 注意：目前，randombots 在创建公会后不会邀请更多机器人，
# 这意味着随机机器人公会将只有签署章程所需的 10 个初始随机机器人
# 默认：0 （禁用）
AiPlayerbot.RandomBotGuildNearby = 0

# randombots 创建的公会数量
AiPlayerbot.RandomBotGuildCount = 20

# randombot 公会的最大成员数量（最小硬编码为 10）
AiPlayerbot.RandomBotGuildSizeMax = 15

# 如果设置为 1，则删除所有 randombot 公会
AiPlayerbot.DeleteRandomBotGuilds = 0

# 随机机器人将邀请玩家加入团体/团队/公会
AiPlayerbot.RandomBotInvitePlayer = 0

# 当机器人邀请其他机器人加入队伍/团队/公会时，他们会在 say/guild 中聊天
AiPlayerbot.InviteChat = 0

# 当玩家接受队伍邀请时，机器人会自动召唤到玩家身边
AiPlayerbot.SummonWhenGroup = 1

# 玩家可以被激活为机器人（selfbot）
# Selfbot 权限级别（0 = 禁用，1 = 仅 GM（默认），2 = 所有玩家，3 = 登录时激活）
AiPlayerbot.SelfBotLevel = 1

# 非GM玩家只能使用init=auto根据自己的等级和装备分数来初始化机器人
# 默认：0 （非 GM 玩家可使用任意初始化命令）
AiPlayerbot.AutoInitOnly = 0

# 允许 .bot refresh=raid 取消绑定玩家创建的 alt 上的实例
# 机器人（非 addclass 机器人）。当为 0 时，alts 上的刷新=raid 被拒绝
# 出现“non-addclass bot”错误。 UnbindInstance 是轻量级 DB，无延迟
# 启用此功能的风险。
# 默认：0
AiPlayerbot.ResetInstanceIdForAltBots = 0

# init=auto bot装备等级上限比例
# 默认：1.0 （与玩家相同）
AiPlayerbot.AutoInitEquipLevelLimitRatio = 1.0

# 允许学习训练师法术
# 描述：只要有钱，就可以让机器人学习训练师的法术。
# 默认：1 - （启用）
AiPlayerbot.AllowLearnTrainerSpells = 1

#
#
####################################################################################################

####################################################################################################
# 召唤选项
#

# 当主人处于战斗状态时启用/禁用召唤机器人
# 默认：1 （启用）
AiPlayerbot.AllowSummonInCombat = 1

# 当主人死亡时启用/禁用召唤机器人
# 默认：1 （启用）
AiPlayerbot.AllowSummonWhenMasterIsDead = 1

# 当机器人死亡时启用/禁用召唤机器人（0 = 仅当机器人是幽灵时，1 = 始终）
# 默认：1 （始终）
AiPlayerbot.AllowSummonWhenBotIsDead = 1

# 召唤复活机器人时启用/禁用它们（0 = 禁用，1 = 在战斗中禁用，2 = 启用）
# 默认：1 （战斗中禁用）
AiPlayerbot.ReviveBotWhenSummoned = 1

# 启用/禁用机器人在召唤时修复装备
# 默认：1 （启用）
AiPlayerbot.BotRepairWhenSummon = 1

#
#
####################################################################################################

####################################################################################################
# 山
#

# 定义机器人在什么级别自然会使用其 60% 地面坐骑
# 注：WotLK 期间为 20 级，TBC 期间为 30 级，Vanilla 期间为 40 级
# 默认：20
AiPlayerbot.UseGroundMountAtMinLevel = 20

# 定义机器人在什么级别自然会使用其 100% 快速地面安装
# 注：WotLK 期间为 40 级，Vanilla 期间为 60 级
# 默认：40
AiPlayerbot.UseFastGroundMountAtMinLevel = 40

# 定义机器人在什么级别自然会使用其 150% 飞行坐骑
# 注：WotLK期间为60级，TBC期间为70级
# 默认：60
AiPlayerbot.UseFlyMountAtMinLevel = 60

# 定义机器人在什么级别自然会使用其 280% 快速飞行坐骑
# 注：WotLK和TBC期间为70级
# 默认：70
AiPlayerbot.UseFastFlyMountAtMinLevel = 70

#
#
####################################################################################################

####################################################################################################
# 装备
#

# 随机机器人头盔/披风显示（0 = 始终隐藏，1 = 启用）
# 启用后，全局「显示比例」0～100 会与 Min/MaxRandomBots 使用相同间隔重新随机；
# 每次 randomize 按该比例对每个 bot 随机显示或隐藏，无需额外配置比例。
AiPlayerbot.RandomBotShowHelmet = 1
AiPlayerbot.RandomBotShowCloak = 1

# altbot 是否自动装备背包中足够好的升级物品
# 默认：1（启用）
AiPlayerbot.AutoEquipUpgradeLoot = 1

# 自动装备升级物品的阈值
# 默认：1.1（新物品装备评分高于当前装备 1.1 倍时装备）
AiPlayerbot.EquipUpgradeThreshold = 1.1

# 两轮装备初始化，打造更适合的装备
AiPlayerbot.TwoRoundsGearInit = 0

#
#
####################################################################################################

####################################################################################################
# 抢劫
#

# 当战利品系统设置为对所有人免费时，机器人会继续进行掠夺
# 默认：0 （禁用）
AiPlayerbot.FreeMethodLoot = 0

# 机器人的掷骰等级机器人将用于他们需要的物品（0 = 通过，1 = 贪婪，2 = 需要）
# 默认：1 （贪婪）
AiPlayerbot.LootNeedRollLevel = 1

# 使机器人能够在物品上滚动 GREED（全局切换）
# 如果禁用，机器人将对所有项目都通过而不是贪婪
# 默认：0 （禁用 - 机器人仅需求或放弃）
AiPlayerbot.LootGreedRollLevel = 0

# 使机器人能够滚动执行食谱。需要他们还不知道的可学习的专业食谱
# 如果启用 LootRollGreed，机器人将在无法学习的 BoE 食谱上滚动 GREED。
# 默认：0 （禁用）
AiPlayerbot.LootRollRecipe = 0

# 具有附魔的机器人会对可分解的物品投掷“DISENCHANT”而不是“GREED”
# 如果禁用，机器人将贪婪于可分解的物品
# 默认：0 （禁用）
AiPlayerbot.LootRollDisenchant = 0

# 机器人不会与之交互的游戏对象 GUID 列表。
# 默认 GUID 列表：
# 任务物品：
# 英雄之血=176213、迪菲亚火药=17155、浸水信封=2656、巴洛格宝箱=123329、半埋瓶子=2560
# 宝箱：
# 大型实心宝箱 = 74448，一盒什锦零件 = 19020，食物箱 = 3719，水桶 = 3658，一桶牛奶 = 3705，一桶甜酒 = 3706，破烂的宝箱 = 105579，大型改良宝箱 = 75293，实心宝箱 = 2857，破烂的食品柜 = 179490、巫医宝箱 = 141596、圣物保险箱 = 160836、黑暗保险箱 = 160845、芬格斯宝箱 = 179516、补给箱 = 176224/181085、玛洛尔保险箱 = 176112
# 其他：
# 浅坟墓（祖尔法拉克）= 128308/128403，冷酷狂饮野猪（黑石深渊）= 165739，黑铁啤酒杯（黑石深渊）= 165738，火焰之父（黑石塔）= 175245，未锻造的符文胸甲（黑石塔）= 175970，锻造计划（斯坦索姆）= 176325/176327
AiPlayerbot.DisallowedGameObjects = 176213,17155,2656,74448,19020,3719,3658,3705,3706,105579,75293,2857,179490,141596,160836,160845,179516,176224,181085,176112,128308,128403,165739,165738,175245,175970,176325,176327,123329,2560

#
#
####################################################################################################

####################################################################################################
# 定时器
#

# 每个周期的最大 AI 迭代次数
AiPlayerbot.IterationsPerTick = 10

# 两次施放短时法术之间的延迟
AiPlayerbot.GlobalCooldown = 500

# 移动时的最长等待时间
AiPlayerbot.MaxWaitForMove = 5000

# 启用/禁用使用 MoveSplinePath 进行机器人移动
# 禁用将导致更加不稳定的运动，但需要眩晕、圈套和定身才能对机器人起作用
# 默认：0 - MoveSplinePath enabled
# 1 - 仅在 BG/Arena 中禁用 MoveSplinePath
# 2 - MoveSplinePath 随处禁用
AiPlayerbot.DisableMoveSplinePath = 0

# 移动的最大搜索时间（越长，斜坡上的移动效果越好）
# 默认：3
AiPlayerbot.MaxMovementSearchTime = 3

# 动作过期时间
AiPlayerbot.ExpireActionTime = 5000

# 最大驱散光环持续时间
AiPlayerbot.DispelAuraDuration = 700

# 两个机器人操作之间的延迟
AiPlayerbot.ReactDelay = 100

# 动态调整不同状态机器人的反应延迟，减少服务器延迟
AiPlayerbot.DynamicReactDelay = 1

# 不活动延迟
AiPlayerbot.PassiveDelay = 10000

# 重复操作（聊天消息、表情等）之间的最小延迟
AiPlayerbot.RepeatDelay = 2000

# 延时定时器
AiPlayerbot.ErrorDelay = 100
AiPlayerbot.RpgDelay = 10000
AiPlayerbot.SitDelay = 20000
# ReturnDelay 的最小值为 2000 - 较低的值会导致崩溃！
AiPlayerbot.ReturnDelay = 2000
AiPlayerbot.LootDelay = 1000

#
#
####################################################################################################

####################################################################################################
# 距离
#

# 距离以码为单位
AiPlayerbot.FarDistance = 20.0
AiPlayerbot.SightDistance = 100.0
AiPlayerbot.SpellDistance = 28.5
AiPlayerbot.ShootDistance = 5.0
AiPlayerbot.HealDistance = 38.5
AiPlayerbot.LootDistance = 15.0
AiPlayerbot.FleeDistance = 5.0
AiPlayerbot.AggroDistance = 22
AiPlayerbot.TooCloseDistance = 5.0
AiPlayerbot.MeleeDistance = 0.75
AiPlayerbot.FollowDistance = 1.5
AiPlayerbot.WhisperDistance = 6000.0
AiPlayerbot.ContactDistance = 0.45
AiPlayerbot.AoeRadius = 10
AiPlayerbot.RpgDistance = 200
AiPlayerbot.GrindDistance = 75.0
AiPlayerbot.ReactDistance = 150.0

#
#
####################################################################################################

####################################################################################################
# 门槛
#

# 生命值/法力等级
AiPlayerbot.CriticalHealth = 25
AiPlayerbot.LowHealth = 45
AiPlayerbot.MediumHealth = 65
AiPlayerbot.AlmostFullHealth = 85
AiPlayerbot.LowMana = 15
AiPlayerbot.MediumMana = 40
AiPlayerbot.HighMana = 65

#
#
####################################################################################################

####################################################################################################
# 任务
#

# 机器人选择他们的任务奖励
# 是=选择最有用的项目，否=列出所有奖励，询问=选择有用的项目并列出（如果有多个）
AiPlayerbot.AutoPickReward = yes

# 与玩家同步任务（机器人将在您交出任务后立即完成任务，并且不会掠夺任务物品。）
# 默认：1 （启用）
AiPlayerbot.SyncQuestWithPlayer = 1

# 机器人在提交机器人任务时会自动为玩家完成任务
# 默认：0 （禁用）
AiPlayerbot.SyncQuestForPlayer = 0

# 机器人会丢弃过时的任务
# 默认：1 （启用）
AiPlayerbot.DropObsoleteQuests = 1

#
#
####################################################################################################

####################################################################################################
# 战斗
#

# 如果实施，进入实例时自动添加地下城/团队策略
AiPlayerbot.ApplyInstanceStrategies = 1

# 启用自动回避aoe策略
# 默认：1 （启用）
AiPlayerbot.AutoAvoidAoe = 1

# 只躲避半径小于该值的aoe法术
AiPlayerbot.MaxAoeAvoidRadius = 15.0

# 不应避免的 aoe 法术 ID 白名单
AiPlayerbot.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# 启用治疗机器人保存法力策略
# 默认：1 （启用）
AiPlayerbot.AutoSaveMana = 1

# 治疗机器人节省法力阈值
# 默认：60 (60%)
AiPlayerbot.SaveManaThreshold = 60

# 使圣骑士机器人能够使用更大的祝福，所使用的祝福基于
# 团队/团体中的圣骑士数量以及接收者的规格。每个人的优先事项
# 规范硬编码在 GreaterBlessingActions.h 中。
# 0 = 禁用
# 1 = 仅在 raid 组中启用
# 2 = 在所有组中启用
# 默认：1 （仅团队）
AiPlayerbot.AutoGreaterBlessings = 1

# 使机器人能够使用团体试剂增益：野性的礼物、奥术光辉、
# 坚韧祈祷、精神祈祷和暗影保护祈祷。
# 0 = 禁用
# 1 = 仅在 raid 组中启用
# 2 = 在所有组中启用
# 默认：2 （所有队伍）
AiPlayerbot.AutoPartyBuffs = 2

# 当机器人尝试使用基于试剂的强效祝福或群体增益时，机器人会告诉团队
# 但由于试剂耗尽，不得不退回到单目标版本。
# 默认：1 （启用）
AiPlayerbot.TellWhenMissingBuffReagents = 1

# 缺少增益试剂消息的冷却时间（以秒为单位）。
# 默认：300 （5 分钟）
AiPlayerbot.MissingBuffReagentMessageCooldown = 300

# 机器人可以逃离敌人
AiPlayerbot.FleeingEnabled = 1

#
#
####################################################################################################

####################################################################################################
# 秘籍
#

# 启用/禁用维护命令
# 学习所有可用的法术和技能，分配天赋点，刷新消耗品，修理，附魔装备，插槽宝石等。
# 如果机器人的等级高于 AiPlayerbot.MinEnchantingBotLevel，则适用
# 默认：1 （启用）
AiPlayerbot.MaintenanceCommand = 1

# 启用/禁用 altbot 的特定维护命令功能
# 禁用以防止玩家向他们的 altbot 提供免费的包、咒语、技能等级等
# 默认：1 （启用）
AiPlayerbot.AltMaintenanceAmmo = 1
AiPlayerbot.AltMaintenanceFood = 1
AiPlayerbot.AltMaintenanceReagents = 1
AiPlayerbot.AltMaintenanceConsumables = 1
AiPlayerbot.AltMaintenancePotions = 1

AiPlayerbot.AltMaintenanceBags = 1
AiPlayerbot.AltMaintenanceMounts = 1
AiPlayerbot.AltMaintenanceSkills = 1

# “特殊法术”包括 AiPlayerbot.RandomBotSpellIds 和死亡骑士死亡之门中列出的任何法术
AiPlayerbot.AltMaintenanceClassSpells = 1
AiPlayerbot.AltMaintenanceAvailableSpells = 1
AiPlayerbot.AltMaintenanceSpecialSpells = 1
AiPlayerbot.AltMaintenanceTalentTree = 1
AiPlayerbot.AltMaintenanceGlyphs = 1
AiPlayerbot.AltMaintenanceGemsEnchants = 1

AiPlayerbot.AltMaintenancePet = 1
AiPlayerbot.AltMaintenancePetTalents = 1

AiPlayerbot.AltMaintenanceReputation = 1
AiPlayerbot.AltMaintenanceAttunementQuests = 1
AiPlayerbot.AltMaintenanceKeyring = 1

# 启用/禁用 autogear 命令，该命令自动升级机器人的装备
# 质量受 AutoGearQualityLimit 和 AutoGearScoreLimit 限制
# 默认：1 （启用）
AiPlayerbot.AutoGearCommand = 1

# 在 altbot 上启用/禁用 autogear 命令
# 默认：1 （启用）
AiPlayerbot.AutoGearCommandAltBots = 1

# 若为 1（启用），聊天命令 autogear bis 会从 playerbots_bis_gear 表给予机器人 BiS 装备
# 物品等级下限与 AutoGearScoreLimit 匹配（如 290 = ICC，245 = ToC，
# 125 = 卡拉，78 = MC）。完整列表见下方 AutoGearScoreLimit 注释。
# 聊天命令 autogear bis x（x 须为正整数）按 x 的值给予物品。
# 若 x 大于 AutoGearScoreLimit 则不给 bis；若更小则按 x 匹配给予。
# 无匹配 tier 或该职业/天赋表为空时，命令回退为 autogear。
# 需要 AutoGearQualityLimit = 4 且 AutoGearCommand = 1。
# 若 AutoGearCommandAltBots = 1，alt 机器人也可使用。
# 默认：0（禁用）
AiPlayerbot.AutoGearBisCommand = 0

# 自动装备命令的装备质量限制（1 = 普通，2 = 不常见，3 = 稀有，4 = 史诗，5 = 传奇）
# 默认：3 （精良）
AiPlayerbot.AutoGearQualityLimit = 3

# autogear 命令的装备物品等级（非 gearscore）上限（0 = 无限制）
# 经典旧世
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# 燃烧的远征
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# 巫妖王之怒
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# 默认：0（无限制）
AiPlayerbot.AutoGearScoreLimit = 0

# 启用/禁用机器人作弊
# "food"（机器人无需消耗背包食物/饮料即可吃喝）
# "gold"（机器人拥有无限金币）
# "health"（机器人立即恢复生命值）
# "mana"（机器人拥有无限法力）
# "power"（机器人拥有无限能量、怒气与符文能量）
# "taxi"（机器人可使用所有飞行路线，但不会真正学会）
# "raid"（机器人在团队策略中使用特定作弊）
# 多种作弊用逗号分隔（例如全部启用："gold,health,mana,power,raid,taxi"）
# 默认：启用 food、taxi、raid
AiPlayerbot.BotCheats = "food,taxi,raid"

# 所有机器人自动完成的副本准入任务 ID 列表（逗号分隔）
# mod-playerbots 不会恢复已移除的副本准入要求，但 mod-individual-progression 等模块可能会；
