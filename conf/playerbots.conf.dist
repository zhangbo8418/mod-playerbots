#
####################################################################################################

####################################################################################################
# 专业
#

# 每个类存储桶中接收类匹配的随机机器人的百分比
# 加权职业组合。其余的随机机器人使用加权
# 随机的理智配对职业池。
# 默认：30
AiPlayerbot.ClassMatchingProfessionChance = 30

# 当机器人掌握钓鱼技能时，自动为具有钓鱼技能的机器人添加“钓鱼大师”策略。
# 默认：1 （启用）
AiPlayerbot.EnableFishingWithMaster = 1

# 具有主人的机器人将寻找水来钓鱼的距自身的距离（以码为单位）
AiPlayerbot.FishingDistanceFromMaster = 10.0

# 没有主人的机器人将寻找水来钓鱼的距离自身的距离（以码为单位）
# 目前不相关，因为无主机器人不会钓鱼
AiPlayerbot.FishingDistance = 40.0

# 与水的距离（以码为单位），超过该距离机器人将删除“主钓鱼”策略
AiPlayerbot.EndFishingWithMaster = 30.0

#
#
####################################################################################################

#######################################
#                                     #
# 随机机器人专用设置                #
#                                     #
#######################################

####################################################################################################
# 一般的
#

# 启用/禁用 randombot 账户的随机生成密码
AiPlayerbot.RandomBotRandomPassword = 0

# 随机机器人的最低和最高级别
AiPlayerbot.RandomBotMinLevel = 1
AiPlayerbot.RandomBotMaxLevel = 80

# 将最大随机机器人级别与在线玩家的最大级别同步
# 默认：0 （禁用）
AiPlayerbot.SyncLevelWithPlayers = 0

# 将许多任务 ≤ 机器人等级标记为已完成（减慢机器人创建速度）
# 默认：0 （禁用）
AiPlayerbot.PreQuests = 0

# 为随机机器人启用寻求组队
# 默认：1 （启用）
AiPlayerbot.RandomBotJoinLfg = 1

# 启用/禁用随机机器人的定期在线-离线，以模拟并非所有玩家同时在线的现实场景
# 启用后，会从更大的集合中随机选择随机机器人定期上线或离线
# 默认：0 （禁用，在线机器人集合保持固定）
AiPlayerbot.EnablePeriodicOnlineOffline = 0

# 定义随机机器人总数（包括离线机器人）与当前在线随机机器人数量之间的比率（MaxRandomBots）
# 此设置必须大于 1.0，并且仅在 EnablePeriodicOnlineOffline 时应用
# 默认：2.0 （机器人总数为 MaxRandomBots 的两倍）
AiPlayerbot.PeriodicOnlineOfflineRatio = 2.0

# 联盟和部落随机机器人的百分比
AiPlayerbot.RandomBotAllianceRatio = 50
AiPlayerbot.RandomBotHordeRatio = 50

# 禁用死亡骑士机器人的登录
AiPlayerbot.DisableDeathKnightLogin = 0

# 启用人才和字形的模拟扩展限制
# 如果启用，则将天赋树限制为 6 行，加上机器人第 7 行的中间天赋，直到 61 级
# 8行加上第9行的中间天赋，适用于61级到71级的机器人
# 默认：0 （禁用）
AiPlayerbot.LimitTalentsExpansion = 0

# 配置随机机器人交易（0：禁用，1：启用，2：仅买入，3：仅卖出）
# 默认：1 （启用）
AiPlayerbot.EnableRandomBotTrading = 1

# 配置将在交易操作分析中排除的消息前缀以打开交易窗口
AiPlayerbot.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

# 允许机器人发送邮件。禁用后，机器人将不会邮寄物品或金钱
# 响应聊天命令（“发送邮件”）。
# 默认：1 （启用）
AiPlayerbot.BotSendMailEnabled = 1

#
#
####################################################################################################

####################################################################################################
# 级别
#

# 禁用随机级别生成的随机机器人
# 如果禁用，每个随机机器人都会从指定级别开始（但仍然可以通过杀死小怪和任务来升级）
AiPlayerbot.DisableRandomLevels = 0

# 如果启用“AiPlayerbot.DisableRandomLevels”，请在此处设置随机机器人的起始级别
AiPlayerbot.RandombotStartingLevel = 1

# 机会随机机器人在第一次随机化时具有最低级别
# 默认：0.1 (10%)
AiPlayerbot.RandomBotMinLevelChance = 0.1

# 机会随机机器人在第一次随机化时具有最高级别
# 默认 0.1 (10%)
AiPlayerbot.RandomBotMaxLevelChance = 0.1

# 修复随机机器人的等级（它们不会升级）
# 默认：0 （禁用）
AiPlayerbot.RandomBotFixedLevel = 0

# 将 RandomBotMaxLevel 机器人设置为 RandomBotMinLevel
# 默认：0 （禁用）
AiPlayerbot.DowngradeMaxLevelBot = 0

# 随机机器人经验倍率（默认：1.0）
# 服务器 XP 率 * AiPlayerbot.RandomBotXPRate
AiPlayerbot.RandomBotXPRate = 1.0

#
#
####################################################################################################

####################################################################################################
# 装备
#

# 随机机器人升级时自动获得更高等级装备
# 默认：1（启用）
AiPlayerbot.AutoUpgradeEquip = 1

# 启用/禁用哪些（如果有）随机机器人在登录期间保留其当前设备和规格
# 和周期性随机化（即持久性）。
# 默认：1 （启用）
AiPlayerbot.EquipAndSpecPersistence = 1

# 如果启用EquipAndSpecPersistence，装备和天赋的持久性将影响该随机机器人
# 级别或更高。
# 默认：1 （对至少 1 级的随机机器人启用持久化，即所有等级）
AiPlayerbot.EquipAndSpecPersistenceLevel = 1

# 随机机器人的装备质量限制（1 = 正常，2 = 罕见，3 = 稀有，4 = 史诗，5 = 传奇）
# 这也设置了 autogear 可以为 randombots 和 altbots 生成的最高质量
# 默认：3 （精良）
AiPlayerbot.RandomGearQualityLimit = 3

# 随机机器人的装备物品等级（非 gearscore）上限（0 = 无限制）
# 经典旧世
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# 燃烧的远征
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# 巫妖王之怒
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# 默认：0（无限制）
AiPlayerbot.RandomGearScoreLimit = 0

# 优先选择班级理想类型的盔甲：对适合班级的盔甲应用 3 倍分数乘数。
# 启用后，战士强烈喜欢板甲，萨满更喜欢邮件等。
# 真正优质的产品仍然可以获胜（没有硬过滤），但质量相同
# 首选类型的盔甲得分会高出 3 倍并被装备。
#
# 装甲类型偏好：
# 板甲：战士、圣骑士、死亡骑士
# 邮件：猎人、萨满
# 皮革：盗贼、德鲁伊
# 布料：牧师、法师、术士
#
# 默认：0 （禁用）
AiPlayerbot.PreferClassArmorType = 0

# 启用后，机器人会在自动装备期间根据速度和武器类型更喜欢适合规格的武器。
# 示例：武器战士喜欢缓慢的 2H 斧头/长柄武器（斧头专精）、战斗盗贼
# 喜欢慢速的 MH 和快速的 OH，而增强萨满则喜欢同步慢速的 1H 武器。
# 默认：0 （禁用）
AiPlayerbot.PreferredSpecWeapons = 0

# 设置机器人的最低级别，这些机器人将通过维护将宝石附魔并将宝石插入其设备中
# 如果大于 RandomBotMaxlevel，机器人将不会自动为装备或插槽宝石附魔
# 默认：60
AiPlayerbot.MinEnchantingBotLevel = 60

# 启用机器人附魔和宝石的扩展限制
# 如果启用，机器人在 61 级之前不会使用 TBC 附魔，在 71 级之前不会使用 WotLK 附魔和宝石
# 默认：1 （启用）
AiPlayerbot.LimitEnchantExpansion = 1

# 启用装备资料片限制
# 如果启用，机器人在 61 级之前不会装备 TBC 装备，在 71 级之前不会装备 WotLK 装备
# 默认：1 （启用）
AiPlayerbot.LimitGearExpansion = 1

# randombot 可能会生成未优化的装备
# 设置在 0 (0%) 和 1 (100%) 之间
AiPlayerbot.RandomGearLoweringChance = 0

# 无法获得或无法使用的物品（以逗号分隔的物品 ID 列表）
# 默认值：奇尔顿魔杖（12468），狂怒之心徽章测试/使用行（44869），
# 洗礼神谕护身符测试/使用行 (44870)、大地之环图腾 (46978)
AiPlayerbot.UnobtainableItems = 12468,44869,44870,46978

# 随机机器人检查玩家的装备分数水平，如果太低则拒绝队伍邀请
# 默认：0 （禁用）
AiPlayerbot.GearScoreCheck = 0

# 仅为猎人设置狼宠物以获得最佳团队性能（0 = 禁用，1 = 仅针对最高级别机器人启用，2 = 启用）
# 默认：0 （禁用）
AiPlayerbot.HunterWolfPet = 0

# 机器人召唤宠物时的默认宠物姿势
# 0 = 被动，1 = 防御，2 = 攻击
# 默认：1 （防御）
AiPlayerbot.DefaultPetStance = 1

# 启用/禁用有关 pet 命令的调试消息
# 0 = 禁用，1 = 启用
# 默认：0（禁用）
AiPlayerbot.PetChatCommandDebug = 0

# 禁止猎人机器人在 ExcludedHunterPetFamilies 中创建具有下列任何家庭 ID 的宠物
# 按ID查看所有宠物家族的creation_family数据库表（注意：蜘蛛的ID为3）
AiPlayerbot.ExcludedHunterPetFamilies = ""

#
#
####################################################################################################

####################################################################################################
# 活动
#

# 机器人单独活动
# - 控制当附近没有真实玩家时有多少机器人处于活动状态。
# - 将其视为一个粗略的百分比：10 表示大约 10% 的机器人将处于活动状态。
# 不准确——每个旋转周期的实际数量可能略有不同。
# - 活动机器人轮换：每 <DurationSeconds> 一组不同的机器人轮流。
# - 活跃机器人的实际数量将始终高于该值，因为
#   combat, dungeons, 战场, 寻求组队 queue, groups with real players, etc. are always
# 在此之上强制激活（参见下面的强制规则）。
# - 设置为 100（SmartScale 关闭）= 所有机器人始终处于活动状态。最大服务器负载。
# - 设置为 0 = 仅匹配以下强制规则的机器人才会处于活动状态。
#
# 机器人单独活动持续时间秒
# - 活跃名单轮换的频率（以秒为单位）。另一组机器人醒来
# 并且前一组可能会闲置。
# - 这是最小值，并不精确。如果机器人处于战斗状态或满足任何强制规则
# 轮换发生时，它会保持活动状态，直到这些条件结束 - 它不会被切断
# 战斗中，只是因为轮到了。
#
AiPlayerbot.BotActiveAlone = 10
AiPlayerbot.BotActiveAloneDurationSeconds = 30

# 强制激活规则（1 = 打开，0 = 关闭）
# 这些会覆盖上面的百分比。如果满足这些条件中的任何一个，机器人就会保持活动状态。
#
# InRadius - 真实玩家在这么多码内（设置为 0 以禁用）。
# InZone - 真实玩家位于同一区域（例如艾尔文森林）。
# InMap - 真实玩家位于同一大陆（例如东部王国）。
# IsFriend - 真实玩家在其好友列表中拥有此机器人。
# InGuild - 该机器人位于一个有真实玩家的公会中。
#
# 在以下情况下，机器人也始终被强制激活（不可配置）：
#   in combat, inside a dungeon/raid/BG, in a BG or 寻求组队 queue,
# 与真实玩家分组，或由真实玩家控制。
#
AiPlayerbot.BotActiveAloneForceWhenInRadius = 150
AiPlayerbot.BotActiveAloneForceWhenInZone = 1
AiPlayerbot.BotActiveAloneForceWhenInMap = 0
AiPlayerbot.BotActiveAloneForceWhenIsFriend = 0
AiPlayerbot.BotActiveAloneForceWhenInGuild = 1

# SmartScale — 当服务器出现问题时自动减少活动机器人。
# 监视服务器的更新时间（每个服务器滴答所需的时间以毫秒为单位）。
# 当服务器速度变慢时，保持活动状态的机器人就会减少，以减少负载。
#
# 下限（默认 50 毫秒）- 低于此值，不减少。服务器运行良好。
# 上限（默认 200 毫秒）- 达到或超过此值时，所有非强制机器人都会暂停。
# 在地板和天花板之间，活动规模逐渐缩小。
# 示例：BotActiveAlone=10，下限=50，上限=200
# 服务器 50 毫秒 → 活动时间约 10%（无减少）
# 服务器 125 毫秒 → 活动时间约 5%（减少一半）
# 服务器处于 200 毫秒 → 0% 活跃（仅保留强制机器人）
#
# MinLevel/MaxLevel — 只有此级别范围内的机器人才会受到 SmartScale 的影响。
# 范围之外的机器人始终使用完整的 BotActiveAlone 值。
# 强制规则始终胜过 SmartScale。
#
AiPlayerbot.botActiveAloneSmartScale = 1
AiPlayerbot.botActiveAloneSmartScaleDiffLimitfloor = 50
AiPlayerbot.botActiveAloneSmartScaleDiffLimitCeiling = 200
AiPlayerbot.botActiveAloneSmartScaleWhenMinLevel = 1
AiPlayerbot.botActiveAloneSmartScaleWhenMaxLevel = 80

#
#
####################################################################################################

####################################################################################################
# 任务
#

# 所有随机机器人都将完成并获得奖励的任务
AiPlayerbot.RandomBotQuestIds = "3802,5505,6502,7761,7848,10277,10285,11492,13188,13189,24499,24511,24710,24712"

# 随机机器人将与附近的随机机器人分组执行共享任务
# 注意：目前无法正常运行
AiPlayerbot.RandomBotGroupNearby = 0

# 随机机器人会自行选择任务并尝试完成它们
# 默认：1 （启用）
AiPlayerbot.AutoDoQuests = 1

# 任务物品保留在机器人的库存中（不会自动销毁）
AiPlayerbot.RandomBotQuestItems = "5175,5176,5177,5178,6948,11000,12382,13704,16309"

#
#
####################################################################################################

####################################################################################################
# 咒语
#

# 随机机器人在升级时自动学习职业任务奖励咒语
# 默认：1 （启用）
AiPlayerbot.AutoLearnQuestSpells = 1

# 随机机器人在升级时自动学习可训练的法术
# 默认：1 （启用）
AiPlayerbot.AutoLearnTrainerSpells = 1

# 随机机器人会自动将天赋点用于升级
# 默认：1 （启用）
AiPlayerbot.AutoPickTalents = 1

# 每个随机机器人都会自动学习咒语，每个替代机器人都会通过维护来学习
# 默认：54197 （Cold Weather Flying）
AiPlayerbot.RandomBotSpellIds = "54197"

# 打开可掠夺宝箱的咒语 ID
AiPlayerbot.OpenGoSpell = 6477

