####################################################################################################

####################################################################################################
# 传送
#

# 机器人可以传送到的地图 ID
# 默认值：0 = 东部王国、1 = 卡利姆多、530 = 外域、571 = 诺森德
AiPlayerbot.RandomBotMaps = 0,1,530,571

# 机器人传送到主城银行员的概率（城市）
# 默认：0.25
AiPlayerbot.ProbTeleToBankers = 0.25

# 控制机器人传送到主城银行员的概率权重
# 权重之和不必为 100。设为 0 可禁用传送到城市。
AiPlayerbot.EnableWeightTeleToCityBankers = 1
AiPlayerbot.TeleToStormwindWeight = 2
AiPlayerbot.TeleToIronforgeWeight = 1
AiPlayerbot.TeleToDarnassusWeight = 1
AiPlayerbot.TeleToExodarWeight = 1
AiPlayerbot.TeleToOrgrimmarWeight = 2
AiPlayerbot.TeleToUndercityWeight = 1
AiPlayerbot.TeleToThunderBluffWeight = 1
AiPlayerbot.TeleToSilvermoonCityWeight = 1
AiPlayerbot.TeleToShattrathCityWeight = 1
AiPlayerbot.TeleToDalaranWeight = 1

# 随机机器人死亡后被传送的距离（码）
AiPlayerbot.RandomBotTeleportDistance = 100

# 机器人等级可比区域内最低级生物低多少级
# 若启用了 AiPlayerbot.EnableNewRpgStrategy，此项无效
# 默认：1 （随机机器人低 1 级以上会离开）
AiPlayerbot.RandomBotTeleLowerLevel = 1

# 机器人等级可比区域内最高级生物高多少级
# 若启用了 AiPlayerbot.EnableNewRpgStrategy，此项无效
# 默认：3 （随机机器人高 3 级以上会离开）
AiPlayerbot.RandomBotTeleHigherLevel = 3

# 机器人升级时会自动传送到其他地点练级
# 默认：1 （启用）
AiPlayerbot.AutoTeleportForLevel = 1

#
#
####################################################################################################

####################################################################################################
# 战场、竞技场与 PvP
#

# Enable 战场/arenas for randombots
AiPlayerbot.RandomBotJoinBG = 1

# Enable auto-joining of 战场 - have bots start 战场 and arenas on their own
AiPlayerbot.RandomBotAutoJoinBG = 0

# RandomBotAutoJoinBG 所需配置
#
# 已知问题：启用多个等级段并配合多实例时，可能导致
# 机器人创建的对局实例多于预期（过度排队）。
#
# This section controls the level brackets and automatic bot participation in 战场 and arenas.
#
# 等级段：
# - 指定机器人自动加入的等级范围（等级段 ID 因战场而异，从各战场最低等级起为 0）：
#   - Warsong Gulch    (WS): 0=10-19, 1=20-29, 2=30-39, 3=40-49, 4=50-59, 5=60-69, 6=70-79, 7=80    (默认：7)
#   - Arathi Basin     (AB): 0=20-29, 1=30-39, 2=40-49, 3=50-59, 4=60-69, 5=70-79, 6=80             (默认：6)
#   - Alterac Valley   (AV): 0=51-60, 1=61-70, 2=71-79, 3=80                                        (默认：3)
#   - Eye of the Storm (EY): 0=61-69, 1=70-79, 2=80                                                 (默认：2)
#   - Isle of Conquest (IC): 0=71-79, 1=80                                                          (默认：1)
# - 可指定多个战场等级段，逗号分隔（例如 "0,2,5"）。不适用于评级竞技场。
#   - Rated Arena:           0=10-14, 1=15-19, 2=20-24, ..., 13=75-79, 14=80-84                     (默认：14)
#
# 数量：
# - 指定每个等级段自动填充的对局数量。
# - For 战场, 'Count" is the number of battles per bracket. For example:
#   - 示例：RandomBotAutoJoinWSBrackets = 6,7
#   - 示例：RandomBotAutoJoinBGWSCount = 1
#   - 上述配置将创建两场对局，分别为等级段 6 与 7。
# - 确保有足够符合条件的机器人以满足指定数量。

# 战场 bracket range possibilities:
# AiPlayerbot.RandomBotAutoJoinWSBrackets = 0,1,2,3,4,5,6,7（战歌等级段示例）
# AiPlayerbot.RandomBotAutoJoinABBrackets = 0,1,2,3,4,5,6（阿拉希等级段示例）
# AiPlayerbot.RandomBotAutoJoinAVBrackets = 0,1,2,3（奥特兰克等级段示例）
# AiPlayerbot.RandomBotAutoJoinEYBrackets = 0,1,2（风暴之眼等级段示例）
# AiPlayerbot.RandomBotAutoJoinICBrackets = 0,1（征服之岛等级段示例）
AiPlayerbot.RandomBotAutoJoinWSBrackets = 7
AiPlayerbot.RandomBotAutoJoinABBrackets = 6
AiPlayerbot.RandomBotAutoJoinAVBrackets = 3
AiPlayerbot.RandomBotAutoJoinEYBrackets = 2
AiPlayerbot.RandomBotAutoJoinICBrackets = 1

# 各 bracket 战场场次数量：
AiPlayerbot.RandomBotAutoJoinBGWSCount = 1
AiPlayerbot.RandomBotAutoJoinBGABCount = 1
AiPlayerbot.RandomBotAutoJoinBGAVCount = 0
AiPlayerbot.RandomBotAutoJoinBGEYCount = 1
AiPlayerbot.RandomBotAutoJoinBGICCount = 0

# Arena支架（仅限单支架）：
# 需要更改自定义代码才能使较低级别的竞技场支架正常运行。
AiPlayerbot.RandomBotAutoJoinArenaBracket = 14

# 竞技场战斗数：
AiPlayerbot.RandomBotAutoJoinBGRatedArena2v2Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena3v3Count = 0
AiPlayerbot.RandomBotAutoJoinBGRatedArena5v5Count = 0

# Randombot 竞技场队伍数量
# 团队是在服务器重新启动时初始化机器人时创建的。
# 您可能需要首先删除所有竞技场团队，然后重新初始化机器人。
# 警告：重新初始化机器人会完全重置它们（游戏中的命令：.playerbots rndbot init）
# 机器人只加入一支竞技场队伍以避免排队问题。增加计数时请考虑到这一点。
# 默认：2v2: 10 (20 Bots), 3v3: 10 (30 bots), 5v5: 5 (25 bots)
AiPlayerbot.RandomBotArenaTeam2v2Count = 10
AiPlayerbot.RandomBotArenaTeam3v3Count = 10
AiPlayerbot.RandomBotArenaTeam5v5Count = 5

# 竞技场等级在团队创建时是随机的。
# 默认：Max: 2000, Min: 1000
AiPlayerbot.RandomBotArenaTeamMaxRating = 2000
AiPlayerbot.RandomBotArenaTeamMinRating = 1000

# 删除所有 randombot 竞技场队伍
AiPlayerbot.DeleteRandomBotArenaTeams = 0

# PvP 限制区（机器人不会发起 PvP 或在受到攻击时保护自己）
AiPlayerbot.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,3951"

# PvP 限制区域（机器人不会发起 PvP 或在受到攻击时保护自己）
AiPlayerbot.PvpProhibitedAreaIds = "976,35,392,2268,4161,4010,4317,4312,3649,3887,3958,3724,4080,3938,3754,3786,3973,4085,4086,4087,4088"

# 提高战场与竞技场反应速度（可能造成卡顿）
AiPlayerbot.FastReactInBG = 1

#
#
####################################################################################################

####################################################################################################
# 随机机器人的时序和行为
#

# randombot 管理器运行其主更新循环的频率（以秒为单位）
# 默认：20
AiPlayerbot.RandomBotUpdateInterval = 20

# 管理器重新评估并调整随机机器人在线数量的最短/最长间隔（秒）
# 当 MinRandomBots < MaxRandomBots 时，每个间隔会在该范围内均匀抽取新的目标在线数。
# 默认：1800（最短），7200（最长）
AiPlayerbot.RandomBotCountChangeMinInterval = 1800
AiPlayerbot.RandomBotCountChangeMaxInterval = 7200

# 随机机器人在线最短/最长时长（秒）
# 默认：600（最短），28800（最长）
AiPlayerbot.MinRandomBotInWorldTime = 600
AiPlayerbot.MaxRandomBotInWorldTime = 28800

# 随机机器人的某些方面在登录和空闲时会定期随机化，
# 包括他们的库存，如果禁用 EquipAndSpecPersistence，还包括他们的设备和规格。
# 此配置设置此类随机事件之间的最小和最大秒数。
# 默认值：7200（最短 - 2 小时）、1209600（最长 - 14 天）
AiPlayerbot.MinRandomBotRandomizeTime = 7200
AiPlayerbot.MaxRandomBotRandomizeTime = 1209600

# 每个管理器更新周期处理的机器人数量（登录、注销、更新）
# 默认：60
AiPlayerbot.RandomBotsPerInterval = 60

# 机器人死亡后复活前的最短和最长秒数
# 默认值：60（最小值）、30​​0（最大值）
AiPlayerbot.MinRandomBotReviveTime = 60
AiPlayerbot.MaxRandomBotReviveTime = 300

# 机器人传送到新区域或区域之间的最小和最大秒数
# 默认值：3600（最小值）、18000（最大值）
AiPlayerbot.MinRandomBotTeleportInterval = 3600
AiPlayerbot.MaxRandomBotTeleportInterval = 18000

# 机器人被标记为永久停留在世界上的秒数（31,104,000 ≈ 1 年）
# 默认：31104000
AiPlayerbot.PermanentlyInWorldTime = 31104000

